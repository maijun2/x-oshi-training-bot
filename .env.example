# X Account User IDs
# These IDs are used by the bot to monitor and interact with specific accounts

# 推しのXアカウントユーザーID
OSHI_USER_ID=

# グループ/ユニットのXアカウントユーザーID
GROUP_USER_ID=

# ボット自身のXアカウントユーザーID
BOT_USER_ID=

# SES通知先メールアドレス（SES で検証済みのアドレス）
NOTIFICATION_EMAIL=

# SES 送信ドメイン（任意）。設定するとドメイン Identity（Easy DKIM + MAIL FROM ses.<domain>）を作成する
SES_SENDER_DOMAIN=

# SES 送信元アドレス（任意）。空なら NOTIFICATION_EMAIL から送る。
# SES_SENDER_DOMAIN の DKIM / MAIL FROM 検証が SUCCESS になってから設定すること
FROM_EMAIL=
